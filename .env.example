# Variables d'environnement à définir dans Netlify (Site settings > Environment variables).
# Ne JAMAIS mettre les vraies valeurs dans ce fichier ni dans le dépôt Git.

# Clé secrète de ton compte Stripe Garden Garden (commence par sk_live_ ou sk_test_)
STRIPE_SECRET_KEY=

# Signature du webhook Stripe, générée quand tu crées le endpoint webhook dans le
# tableau de bord Stripe (Développeurs > Webhooks > Ajouter un endpoint)
STRIPE_WEBHOOK_SECRET=

# URL du Google Apps Script existant (celle déjà utilisée par le site pour les tables)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwNJ-ZJkZebg-IJ-vKzTs966eLpEIyXPZTYWio1gYjCiguMARc7VrlTfMpxHcsT-KCGGA/exec

# Doit être IDENTIQUE à la propriété de script "SHARED_SECRET" définie dans l'éditeur
# Apps Script (Paramètres du projet > Propriétés du script). Choisis une chaîne aléatoire
# longue (ex: générée sur https://1password.com/password-generator/), elle sert à
# vérifier que seule Stripe (via cette fonction) peut créer une réservation "Payée".
GAS_SHARED_SECRET=
